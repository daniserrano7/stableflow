# HyperSync API token: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"
# First block to index. The Ponder indexer starts a few minutes behind head on each
# deploy; pick a recent Base block (HyperIndex has no "latest" start).
ENVIO_START_BLOCK=0
# Optional: stop at a fixed block (used for benchmark and parity runs).
# ENVIO_END_BLOCK=
# Base RPC for the Aave getReserveData read, the only RPC call (comma-separated for
# fallbacks). Defaults to mainnet.base.org and base-rpc.publicnode.com.
# ENVIO_RPC_URL=
# Optional: delete rows older than this many hours (see README, "Retention").
# ENVIO_LIVE_RETENTION_HOURS=
