# HTTPS in front of the web app and the MCP server (compose.prod.yaml). Hostnames come
# from .env (WEB_HOSTS, MCP_HOSTS), so a new server can be tested on its own subdomains
# before DNS moves to it.

{$WEB_HOSTS} {
	encode zstd gzip
	reverse_proxy web:3000
}

www.stableflow.dev {
	redir https://stableflow.dev{uri} permanent
}

{$MCP_HOSTS} {
	reverse_proxy mcp:3000 {
		# The MCP server only answers its public hostname (MCP_ALLOWED_HOST).
		header_up Host mcp.stableflow.dev
	}
}
