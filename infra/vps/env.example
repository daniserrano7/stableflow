# /opt/stableflow/.env on the VPS, read by compose.prod.yaml. Generate each password with
# `openssl rand -hex 24` (hex keeps them safe inside database URLs).
POSTGRES_PASSWORD=
INDEXER_DB_PASSWORD=
WORKER_DB_PASSWORD=
API_DB_PASSWORD=
API_DEV_DB_PASSWORD=

PONDER_RPC_URL_8453=

# Comma-separated hostnames Caddy serves (and gets certificates for).
WEB_HOSTS=stableflow.dev
MCP_HOSTS=mcp.stableflow.dev
