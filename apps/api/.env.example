DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stableflow"
# Schema holding the indexer tables; "stableflow_archive" in production.
DATABASE_SCHEMA="public"
# Live indexer tables for the transfer stream; "stableflow" (the Ponder views) in
# production. Defaults to DATABASE_SCHEMA.
# DATABASE_LIVE_SCHEMA="stableflow"
PORT="3001"
