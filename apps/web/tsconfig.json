{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "~/*": ["app/*"]
    },
    "rootDirs": [".", "./.react-router/types"],
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["@react-router/node", "vite/client"]
  },
  "include": [
    ".react-router/types/**/*",
    "app/**/*.ts",
    "app/**/*.tsx",
    "react-router.config.ts",
    "vite.config.ts"
  ]
}
