{
  "name": "@stableflow/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm codegen && pnpm typecheck",
    "check": "pnpm typecheck",
    "check:env": "tsc -p tsconfig.env.json && node --env-file=.env dist/env-check/src/config/check-env.js",
    "codegen": "PONDER_TELEMETRY_DISABLED=1 ponder codegen",
    "dev": "PONDER_TELEMETRY_DISABLED=1 ponder dev",
    "start": "PONDER_TELEMETRY_DISABLED=1 ponder start",
    "test": "echo \"No tests yet for indexer\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stableflow/shared": "workspace:*",
    "hono": "^4.12.18",
    "ponder": "^0.16.6",
    "viem": "^2.48.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {}
}
