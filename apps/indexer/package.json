{
  "name": "@stableflow/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./base-address-labels": {
      "types": "./src/labels/base-address-labels.ts",
      "default": "./dist/src/labels/base-address-labels.js"
    },
    "./ponder-schema": {
      "types": "./ponder.schema.ts",
      "default": "./dist/ponder.schema.js"
    }
  },
  "scripts": {
    "build": "pnpm codegen && tsc -p tsconfig.json",
    "check": "pnpm typecheck",
    "check:env": "tsc -p tsconfig.env.json && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/env-check/scripts/check-env.js",
    "codegen": "PONDER_TELEMETRY_DISABLED=1 ponder codegen",
    "dev": "DATABASE_SCHEMA=${DATABASE_SCHEMA:-public} PONDER_TELEMETRY_DISABLED=1 ponder dev",
    "inspect:build": "tsc -p tsconfig.json",
    "inspect:flows": "pnpm inspect:build && node --env-file-if-exists=.env.local dist/inspection/flows.js",
    "inspect:reconcile": "pnpm inspect:build && node --env-file-if-exists=.env.local dist/inspection/reconcile.js",
    "inspect:summary": "pnpm inspect:build && node --env-file-if-exists=.env.local dist/inspection/summary.js",
    "inspect:unidentified": "pnpm inspect:build && node --env-file-if-exists=.env.local dist/inspection/unidentified.js",
    "labels:discover": "pnpm inspect:build && node --env-file-if-exists=.env.local dist/inspection/discover.js",
    "labels:worker": "pnpm inspect:build && node --env-file-if-exists=.env.local dist/inspection/discovery-worker.js",
    "labels:report": "pnpm inspect:build && node --env-file-if-exists=.env.local dist/inspection/discovery-report.js",
    "labels:reject": "pnpm inspect:build && node --env-file-if-exists=.env.local dist/inspection/reject-candidate.js",
    "start": "DATABASE_SCHEMA=${DATABASE_SCHEMA:-public} PONDER_TELEMETRY_DISABLED=1 ponder start",
    "start:production": "sh scripts/start-production.sh",
    "test": "pnpm inspect:build && node --test dist/inspection/*.test.js dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stableflow/shared": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.12.18",
    "pg": "^8.20.0",
    "ponder": "^0.16.6",
    "viem": "^2.48.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
