{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/indexer/Dockerfile",
    "watchPatterns": [
      "/apps/indexer/inspection/**",
      "/apps/indexer/src/**",
      "/apps/indexer/package.json",
      "/apps/indexer/Dockerfile",
      "/apps/indexer/railway.worker.json",
      "/pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "node dist/inspection/discovery-worker.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30
  }
}
