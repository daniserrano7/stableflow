{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/indexer/Dockerfile",
    "watchPatterns": [
      "/apps/indexer/src/**",
      "/apps/indexer/ponder.config.ts",
      "/apps/indexer/ponder.schema.ts",
      "/apps/indexer/package.json",
      "/apps/indexer/Dockerfile",
      "/apps/indexer/scripts/start-production.sh",
      "/apps/indexer/scripts/resolve-start-block.ts",
      "/apps/indexer/scripts/start-block.ts",
      "/apps/indexer/railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 3600,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 15
  }
}
