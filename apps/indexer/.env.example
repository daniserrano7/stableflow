DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stableflow-indexer"
DATABASE_SCHEMA="public"
# Production only: Ponder publishes views of the live deployment here (the API and
# label worker read this schema). Requires PONDER_DISCOVERY_START_BLOCK_8453.
# DATABASE_VIEWS_SCHEMA="stableflow"
# Optional. Set to a Base block to backfill from an explicit point.
# If omitted, fresh schemas start at latest; existing schemas resume from Ponder checkpoints.
# PONDER_DISCOVERY_START_BLOCK_8453="0"
PONDER_RPC_URL_8453="https://mainnet.base.org"
# Only for a separate production label-discovery worker. Never set locally.
# NODE_ENV="production"
# LABEL_DISCOVERY_SCHEDULE_ENABLED="true"
# LABEL_DISCOVERY_INTERVAL_MINUTES="360"
# LABEL_DISCOVERY_RETRY_MINUTES="5"
# LABEL_DISCOVERY_WINDOW_MINUTES="1440"
# LABEL_DISCOVERY_LIMIT="50"
# LABEL_DISCOVERY_COOLDOWN_MINUTES="1440"
