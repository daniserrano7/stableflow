PORT="3002"
HOST="127.0.0.1"
STABLEFLOW_API_URL="http://127.0.0.1:3001/v1"
# Set to the public MCP hostname when HOST=0.0.0.0, e.g. mcp.example.com.
# MCP_ALLOWED_HOST="mcp.example.com"
# Set to 1 only behind a trusted single reverse proxy that appends X-Forwarded-For.
TRUST_PROXY_HOPS="0"
MCP_RATE_LIMIT_PER_MINUTE="60"
MCP_MAX_CONCURRENT_REQUESTS="12"
